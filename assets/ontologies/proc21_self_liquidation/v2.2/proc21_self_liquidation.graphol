              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Indica il tasso medio nazionale previsto nella corrispondente voce della tariffa della gestione nella quale è inquadrato il datore di lavoro ex articolo 17 del dm 27.2.2019.</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
          </annotations>
