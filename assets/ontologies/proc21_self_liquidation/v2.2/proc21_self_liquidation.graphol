        <iri>
          <value>https://w3id.org/italia/work-accident/onto/proc21_self_liquidation/UnitaDaDiporto</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/proc21_self_liquidation/UnitaDaDiporto</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Unità da diporto</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/proc21_self_liquidation/UnitaDaDiporto</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Si intende ogni costruzione di qualunque tipo e con qualunque mezzo di propulsione destinata alla navigazione da diporto. Il diporto è disciplinato dal Codice della nautica da diporto e dalla legge 172/2003. Le unità da diporto si distinguono in: Nave, Imbarcazione e Natante.</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/proc21_self_liquidation/UnitaDaDiporto</subject>
