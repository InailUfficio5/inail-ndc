        <iri>
          <value>https://w3id.org/italia/work-accident/onto/proc21_self_liquidation/PremioSilicosiAsbestosiINAIL</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/proc21_self_liquidation/PremioSilicosiAsbestosiINAIL</subject>
