              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>CUP code is assigned to those Bando ISI applications that have been approved and are now marked as eligible for the Bando ISI funding program.</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
