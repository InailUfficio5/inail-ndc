              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Processo attraverso il quale l'INAIL esamina una pratica di finanziamento Bando ISI con l'obiettivo di accertare che il progetto soddisfi i requisiti stabiliti dal bando e che la documentazione fornita sia completa e corretta. La verifica ha una valutazione tecnica e una valutazione amministrativa</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/risk_management/VerificaPraticaProgettoPrevenzione</subject>
