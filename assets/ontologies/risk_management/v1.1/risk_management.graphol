              <object>
                <lexicalForm>Progetto prevenzione</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/risk_management/ProgettoPrevenzione</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Progetto di prevenzione finalizzato a migliorare la sicurezza sul posto di lavoro. Tale progetto viene presentato da un'azienda per ottenere i contributi a fondo perduto del bando ISI.</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/risk_management/ProgettoPrevenzione</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Risk management plan</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/risk_management/ProgettoPrevenzione</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>A risk management plan is a type of document that a business needs to put together to reduce risks in the workplace. In the context of BANDO ISI funding program, a risk management plan is a requirement for the INAIL institution to apply for the grants available in the Bando ISI program.</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
        </iri>
