              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>The Bando ISI review class rapresents the examination process of in the Bando ISI application process. Each Bando ISI application can have more than one examination and different sections of an application can be subjected to an examination by the INAIL institution. </lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
