        <iri>
          <value>https://w3id.org/italia/work-accident/onto/risk_management/codiceGRU</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/risk_management/codiceGRU</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>codice GRU</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/risk_management/codiceGRU</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Il codice GRU è generato automaticamente al momento della presentazione della domanda. Si riferisce a un identificativo univico assegnato a ciascuna domanda presentata dai partecipanti. GRU è l'acronimo di Gestione Richieste Utenti, e questo codice è usato principalmente per tracciare e gestire le pratiche nel sistema informatico INAIL.</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/risk_management/codiceGRU</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>GRU code</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/risk_management/codiceGRU</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>The GRU code is assigned to each application form. It's a unique code that is used to track and manage online application by the INAIL institute.</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
        </iri>
