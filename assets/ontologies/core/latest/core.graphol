        <iri>
          <value>https://w3id.org/italia/work-accident/onto/core/StrutturaINAIL</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/StrutturaINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Struttura INAIL</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/StrutturaINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>La struttura organizzativa dell'Inail comprende:
- le direzioni centrali,
- l'avvocatura generale,
- la sovrintendenza sanitaria centrale,
- la consulenza tecnica per l'accertamento dei rischi e la prevenzione,
- la consulenza statistico attuariale,
- la consulenza tecnica per l'edilizia,
- la consulenza per l'innovazione tecnologica,
- il casellario centrale infortuni,
- il servizio ispettorato e sicurezza,
- il servizio supporto organi,
- le segreterie tecniche di supporto degli organi,
- le direzioni regionali,
- le direzioni provinciali  di Trento e di Bolzamo,
- la sede regionale di Aosta,
- le sedi locali,
- le unità operative territoriali di certificazione, verifica e ricerca.
Sono state inoltre istituite le direzioni territoriali con compiti di coordinamento tra le sedi locali.</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/StrutturaINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>INAIL Territorial Structure</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
