        <iri>
          <value>https://w3id.org/italia/work-accident/onto/core/DittaDiCostruzioniNavali</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/DittaDiCostruzioniNavali</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Ditta Di Costruzioni Navali</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/DittaDiCostruzioniNavali</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Al personale della ditta di costruzioni navali si applica l’assicurazione generale e quindi l’obbligo assicurativo è assolto con le posizioni assicurative territoriali ai sensi del d.m. 12/12/2000. Nel caso la nave di nuova costruzione necessiti di essere sottoposta a delle prove di navigazione a cura del personale del cantiere, l’impresa di costruzione deve assicurare i propri dipendenti per le attività in mare con l’assicurazione per gli addetti alla navigazione e alla pesca marittima. </lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/DittaDiCostruzioniNavali</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Shipbuilding Company</lexicalForm>
                <datatype/>
                <language>en </language>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/work-accident/onto/core/EntePubblico</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/EntePubblico</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Ente Pubblico</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/EntePubblico</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Ente del Settore Pubblico Allargato, istituzione dotata di personalità giuridica. Può essere un'amministrazione pubblica o una delle aziende o altro organismo controllato. Il settore pubblico allargato si compone di enti appartenenti alla pubblica amministrazione - P.a. (enti che producono servizi non destinabili alla vendita) e al settore extra P.a (enti che pur avendo una connotazione giuridica privatistica, ad esempio società per azioni, comunque risentono del controllo pubblico tramite la partecipazione al loro capitale).</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/EntePubblico</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Public Institution</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/work-accident/onto/core/EntePubblicoNonTerritoriale</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/EntePubblicoNonTerritoriale</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Ente Pubblico Non Territoriale</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/EntePubblicoNonTerritoriale</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Enti dotati di personalità giuridica pubblica nei quali non sussiste quale elemento costitutivo il territorio.</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/EntePubblicoNonTerritoriale</subject>
