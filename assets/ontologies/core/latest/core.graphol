        <iri>
          <value>https://w3id.org/italia/work-accident/onto/core/PosizioneAssicurativaTerritoriale</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/PosizioneAssicurativaTerritoriale</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
