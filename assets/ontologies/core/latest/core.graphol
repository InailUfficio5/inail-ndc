        <iri>
          <value>https://w3id.org/italia/work-accident/onto/core/StrutturaINAILCentrale</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/StrutturaINAILCentrale</subject>
