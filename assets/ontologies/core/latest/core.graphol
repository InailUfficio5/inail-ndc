              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/SoggettoAssicuratoINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Sono assicurati all'Inail, in linea generale, tutti i soggetti che svolgono lavoro retribuito alle dipendenze di un datore di lavoro e siano addetti ad una delle attività indicate dall'articolo 1 (per il settore industria) e dagli articoli 204 e seguenti (per il settore agricoltura) del Testo Unico (d.P.R. 1124/1965). Sono assicurate anche alcune categorie di lavoratori autonomi (quali, ad esempio, gli artigiani e i coltivatori diretti), i lavoratori parasubordinati (articolo 4 d.lgs. 38/2000) e altri lavoratori assicurati ai sensi di disposizioni speciali (soggetti di cui alla legge 493/1999, medici e tecnici di radiologia di cui alla legge 93/1958). </lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/SoggettoAssicuratoINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>INAIL Insured Subject</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
        </iri>
