        <iri>
          <value>https://w3id.org/italia/work-accident/onto/core/DenunciaINAIL</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/DenunciaINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Denuncia INAIL</lexicalForm>
                <datatype/>
                <language>it</language>
