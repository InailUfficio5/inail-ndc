        <iri>
          <value>https://w3id.org/italia/work-accident/onto/core/SocietaInAccomanditaSemplice</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/SocietaInAccomanditaSemplice</subject>
