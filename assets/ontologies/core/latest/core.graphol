                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/PosizioneAssicurativaTerritoriale</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>La PAT (posizione assicurativa territoriale) indica la sede di lavoro che coincide con l'unità produttiva (intesa come stabilimento o struttura facente capo alla medesima azienda e dotata di autonomia finanziaria e tecnico funzionale) rilevante ai fini degli adempimenti assicurativi; all'interno della PAT sono registrate le polizze assicurative e le relative voci di rischio assicurato corrispondenti alle tipologie di lavoratori e di attività lavorative esercitate (anagrafica della polizza, voce/i di rischio, dati retributivi).</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/PosizioneAssicurativaTerritoriale</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Territorial Insurance Position</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/work-accident/onto/core/RaccomandatarioMarittimo</value>
