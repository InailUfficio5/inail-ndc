              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/RaccomandatarioMarittimo</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Intermediario di cui si avvale l'armatore residente all'estero che opera in Italia. Il raccomandatario svolge, in nome e per conto del comandante e dell’armatore che rappresenta ogni attività nei confronti dell’Autorità marittima e dell'Inail (L. 135/1977 e art. 290 CdN)</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/work-accident/onto/core/RapportoAssicurativoAttivoINAIL</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/RapportoAssicurativoAttivoINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Rapporto Assicurativo Attivo INAIL</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/RapportoAssicurativoAttivoINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Rapporto giuridico tra l’INAIL (assicuratore), il soggetto obbligato al pagamento del premio (assicurante) e il lavoratore (assicurato), in virtù del quale l’assicuratore tutela l’assicurato contro gli infortuni sul lavoro e le malattie professionali, l’assicurante sopporta l’onere economico della tutela. La tutela consiste in un'erogazione di prestazioni economiche, sanitarie e integrative, a prescindere dall’avvenuto pagamento del premio assicurativo (principio automaticità delle prestazioni cui fanno eccezione alcune tipologie di lavoratori autonomi: - gli artigiani e coltivatori diretti- che, in caso di infortunio o malattia professionale non sono in regola con il versamento del premio assicurativo, non riceveranno le prestazioni economiche fino all'assolvimento dell’obbligo contributivo;    le/i casalinghe/i che subiscono un infortunio in ambito domestico ma, al momento dell'evento lesivo non sono iscritte/i all'assicurazione, non hanno diritto alle prestazioni).</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/RapportoAssicurativoAttivoINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>INAIL Active Insurance Relationship</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
        </iri>
