            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/SocietaIndividuale</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Societa Individuale</lexicalForm>
