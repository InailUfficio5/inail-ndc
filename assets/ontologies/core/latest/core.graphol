            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/core/SocietaIndividuale</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>La ditta individuale è quel tipo di impresa che fa riferimento a un solo titolare, l’imprenditore, il quale è l’unico responsabile e  anche l’unico promotore della sua iniziativa imprenditoriale.

Fonte Esterna INAIL</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
