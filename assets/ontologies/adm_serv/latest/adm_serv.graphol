        <iri>
          <value>https://w3id.org/italia/work-accident/onto/adm_serv/GestioneMediciEspostiARadiazioniIonizzantiINAIL</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/GestioneMediciEspostiARadiazioniIonizzantiINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Gestione medici esposti a radiazioni ionizzanti INAIL</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/GestioneMediciEspostiARadiazioniIonizzantiINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Polizza assicurativa che tutela i medici esposti al rischio di malattie e di lesioni conseguenti all'azione dei raggi X (Legge 93/1958); l'onere dell'assicurazione è a carico dei possessori a qualunque titolo degli apparecchi radiologici, che sono tenuti a presentare all'Istituto apposita denuncia; è dovuto il pagamento di un premio unitario il cui importo è fissato annualmente con decreto ministeriale.</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/GestioneMediciEspostiARadiazioniIonizzantiINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>INAIL management of physician exposed to ionizing radiation</lexicalForm>
                <datatype/>
                <language>en </language>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/work-accident/onto/adm_serv/GestioneNavigazioneINAIL</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/GestioneNavigazioneINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Gestione navigazione INAIL</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/GestioneNavigazioneINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Polizza che tutela gli addetti alla navigazione e alla pesca marittima con onere a carico degli armatori e compresa nella gestione Industria; è previsto il pagamento di un premio ordinario determinato applicando le aliquote stabilite dalla specifica tariffa (aliquote tariffarie in relazione alle categorie assicurative di naviglio previste e determinate in base al tipo di nave, al tipo di servizio a cui la nave è adibita e alle attività in cui sono impegnate le persone imbarcate).</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/GestioneNavigazioneINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>INAIL navigation management</lexicalForm>
                <datatype/>
                <language>en </language>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/work-accident/onto/adm_serv/GestionePolizzaColfINAIL</value>
