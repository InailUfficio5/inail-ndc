              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Assicurazione che tutela i collaboratori domestici; i premi vengono riscossi dall'Inps unitamente ai versamenti dei contributi trimestrali e poi riversati all'INAIL.</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/GestionePolizzaColfINAIL</subject>
