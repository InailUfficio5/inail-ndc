        <iri>
          <value>https://w3id.org/italia/work-accident/onto/adm_serv/InfortunioSulLavoro</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/InfortunioSulLavoro</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Infortunio sul lavoro</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/InfortunioSulLavoro</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Per infortunio sul lavoro si intende ogni lesione originata, in occasione di lavoro, da causa violenta che determini la morte del lavoratore o postumi, temporanei o permanenti, che incidano sulla capacità lavorativa generica o sulla integrità psicofisica.</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/InfortunioSulLavoro</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
