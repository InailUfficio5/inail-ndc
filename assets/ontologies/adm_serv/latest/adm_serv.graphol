        <iri>
          <value>https://w3id.org/italia/work-accident/onto/adm_serv/RivalsaINAIL</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/RivalsaINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Rivalsa INAIL</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/RivalsaINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Le rivalse sono azioni intraprese dall'INAIL per il recupero delle prestazioni erogate o comunque sostenute in conseguenza di un infortunio sul lavoro o di una malattia professionale. Il presupposto è che la responsabilità dell'evento sia riconducibile ad uno più soggetti estranei o meno all'assicurazione. Le tipologie delle azioni di rivalsa sono: il regresso, che viene intrapreso quando sussista la responsabilità del datore di lavoro o di un soggetto del quale egli debba rispondere (articoli 10 e 11 del Testo Unico 1124/1965); la surroga, che viene intrapresa in caso di responsabilità a carico di un terzo estraneo al rapporto assicurativo (articolo 1916 del codice civile).</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/RivalsaINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>INAIL revenge</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/work-accident/onto/adm_serv/SedeLesioneINAIL</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/SedeLesioneINAIL</subject>
