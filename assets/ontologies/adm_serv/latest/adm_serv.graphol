              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Classificazione della sede delle lesioni adottata dall'INAIL. Sono suddivise per codici (73) con la descrizione puntuale della sede anatomica della lesione (da Cranio, codice 11, a Altre dita destre, codice 76) e un'ultima generica ("Altra sede lesione", codice 0). </lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/SedeLesioneINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>INAIL injury site</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/work-accident/onto/adm_serv/Silicosi</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/Silicosi</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Silicosi</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/Silicosi</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Patologia irreversibile, invalidante e incurabile dovuta all'accumulo nel polmone (pneumoconiosi) di polveri di Slc (silice libera cristallina) respirabili, ossia polveri con particelle di dimensioni inferiori a 10 micrometri. Una polvere aerodispersa viene considerata silicotigena se contiene almeno l'1% in peso di Slc.</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/Silicosi</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Silicosis</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
        </iri>
