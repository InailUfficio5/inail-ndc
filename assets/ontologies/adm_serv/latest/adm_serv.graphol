        <iri>
          <value>https://w3id.org/italia/work-accident/onto/adm_serv/ClassificazioneContrattoCNEL</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/ClassificazioneContrattoCNEL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Classificazione contratto CNEL</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/ClassificazioneContrattoCNEL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Il contratto collettivo nazionale di lavoro (CCNL) è il contratto di lavoro stipulato dalle organizzazioni rappresentative dei datori di lavoro e dalle associazioni rappresentative dei lavoratori. Esistono diversi CCNL a seconda della categoria. La contrattazione collettiva si articola anche su diversi livelli locali e aziendali, ma i contratti che hanno maggiore rilevanza sono i contratti collettivi nazionali del lavoro (CCNL).</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/ClassificazioneContrattoCNEL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>CNEL contract classification</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
        </iri>
