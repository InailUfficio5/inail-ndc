        <iri>
          <value>https://w3id.org/italia/work-accident/onto/adm_serv/EventoLesivoINAIL</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/EventoLesivoINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Evento lesivo INAIL</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/EventoLesivoINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Gli eventi lesivi rilevanti ai fini dell'assicurazione gestita dall'Inail sono gli infortuni sul lavoro e le malattie professionali da cui sia derivata una inabilità/menomazione (temporanea o permanente) o la morte. Gli eventi lesivi devono essere denunciati all'Inail e sono riconosciuti in presenza di tutti i presupposti di legge (definizione positiva) o respinti in mancanza dei presupposti di legge (definizione negativa).</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/EventoLesivoINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>INAIL work accident</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
        </iri>
