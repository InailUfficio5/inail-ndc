        <iri>
          <value>https://w3id.org/italia/work-accident/onto/adm_serv/RiaperturaINAIL</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/RiaperturaINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Riapertura INAIL</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/RiaperturaINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Per riapertura della temporanea si intende una ricaduta nello stato di inabilità temporanea assoluta a seguito di un infortunio pregresso, dopo un primo stato di inabilità temporanea assoluta e la ripresa dell'attività lavorativa. Il lavoratore deve informare il datore di lavoro dell'impossibilità di svolgere l'attività lavorativa a causa dell'infortunio occorso in precedenza e fare inoltrare all'Inail il certificato medico telematico con cui si attesta l'avvenuta ricaduta. Il riconoscimento della ricaduta spetta alla funzione sanitaria dell'INAIL.</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/RiaperturaINAIL</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>INAIL reopening</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
        </iri>
