        <iri>
          <value>https://w3id.org/italia/work-accident/onto/adm_serv/ClassificazioneInternazionaleMalattieICD</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/ClassificazioneInternazionaleMalattieICD</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Classificazione internazionale malattie ICD X</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/ClassificazioneInternazionaleMalattieICD</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Edizione italiana della International Classification of Diseases and Related Health Problems, il sistema di classificazione delle malattie stilato dall'Organizzazione mondiale della sanità. Con questo standard internazionale vengono classificate le informazioni sanitarie della rilevazione Istat sui decessi e le cause di morte. Il sistema ripartisce le malattie in 21 settori e ciascun settore contiene una famiglia di malattie; ciascuna malattia è individuata da un codice alfanumerico.</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/work-accident/onto/adm_serv/ClassificazioneInternazionaleMalattieICD</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>International classification of diseases</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
        </iri>
